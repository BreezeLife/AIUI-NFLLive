<script def>
{ "navigationBarTitleText": "NFL Live", "description": "Read-only NFL scores, upcoming schedule, conference standings, and quarter-by-quarter game details. ESPN public JSON feed. Live games refresh about every 30 seconds. Prefer _blank; compact _current supported." }
</script>
<script setup>
import wx from 'wx';
import { strings } from '../../lib/i18n.js';
import { readSettings, saveSettings } from '../../lib/storage.js';
import { request, SCOREBOARD, STANDINGS, normalizeScoreboard, normalizeStandings, demoData } from '../../lib/nfl.js';
export default {
  data: { copy: strings('en'), locale: 'en', tab: 'scores', status: 'loading', statusText: '', snapshot: { season: '', week: '', games: [] }, standings: [], selected: 0, lastUpdated: '' },
  onLoad() { this._dead = false; this._visible = false; this._focused = true; this._timer = null; this._loading = false; this._config = readSettings(wx).value; this.setData({ locale: this._config.locale, copy: strings(this._config.locale), tab: this._config.tab }); },
  onShow() { if (this._visible) return; this._visible = true; this.load(); },
  onHide() { this._visible = false; this.stop(); },
  onUnload() { this._dead = true; this._visible = false; this.stop(); },
  onHostFocus() { this._focused = true; if (this._visible) this.arm(); }, onHostBlur() { this._focused = false; this.stop(); },
  active() { return this._visible && this._focused && !this._dead; },
  stop() { if (this._timer !== null) clearTimeout(this._timer); this._timer = null; },
  arm() { this.stop(); if (!this.active() || !this.liveGames()) return; this._timer = setTimeout(() => { this._timer = null; this.load(); }, 30000); },
  liveGames() { return Boolean(this.data.snapshot?.games?.some(game => game.live)); },
  async load() {
    if (!this.active() || this._loading) return; this._loading = true;
    try {
      if (this._config.source === 'demo') { this.setData({ snapshot: demoData(), standings: demoStandings(), status: 'demo', statusText: this.data.copy.demoFeed, lastUpdated: new Date().toLocaleTimeString() }); }
      else { const [scorePayload, standingsPayload] = await Promise.all([request(wx, SCOREBOARD), request(wx, STANDINGS)]); if (!this.active()) return; this.setData({ snapshot: normalizeScoreboard(scorePayload), standings: normalizeStandings(standingsPayload), status: 'live', statusText: this.data.copy.liveFeed, lastUpdated: new Date().toLocaleTimeString() }); }
    } catch (_) { if (this.active()) this.setData({ status: this.data.snapshot ? 'offline' : 'error', statusText: this.data.snapshot ? this.data.copy.offline : this.data.copy.error }); }
    finally { this._loading = false; this.arm(); }
  },
  refresh() { this.load(); },
  selectTab(event) { const tab = event?.currentTarget?.dataset?.tab; if (!['scores', 'schedule', 'standings', 'detail'].includes(tab) || !this.active()) return; this._config = saveSettings(wx, { ...this._config, tab }) ? { ...this._config, tab } : { ...this._config, tab }; this.setData({ tab }); },
  scores() { this.selectTab({ currentTarget: { dataset: { tab: 'scores' } } }); }, schedule() { this.selectTab({ currentTarget: { dataset: { tab: 'schedule' } } }); }, standings() { this.selectTab({ currentTarget: { dataset: { tab: 'standings' } } }); }, detail() { this.selectTab({ currentTarget: { dataset: { tab: 'detail' } } }); },
  chooseGame(event) { const index = Number(event?.currentTarget?.dataset?.index); if (Number.isInteger(index) && index >= 0 && index < (this.data.snapshot?.games?.length || 0)) this.setData({ selected: index, tab: 'detail' }); },
  setup() { if (this.active()) { try { wx.navigateTo({ url: '/pages/settings/index' }); } catch (_) {} } }
};
function demoStandings() { return [{ name: 'AFC', entries: [{ rank: '1', name: 'Kansas City Chiefs', abbr: 'KC', record: '4-1', pct: '.800' }, { rank: '2', name: 'Buffalo Bills', abbr: 'BUF', record: '3-2', pct: '.600' }, { rank: '3', name: 'Baltimore Ravens', abbr: 'BAL', record: '3-2', pct: '.600' }] }, { name: 'NFC', entries: [{ rank: '1', name: 'Green Bay Packers', abbr: 'GB', record: '4-1', pct: '.800' }, { rank: '2', name: 'Detroit Lions', abbr: 'DET', record: '3-2', pct: '.600' }, { rank: '3', name: 'San Francisco 49ers', abbr: 'SF', record: '3-2', pct: '.600' }] }]; }
</script>
<page>
  <view class="page">
    <view class="heading"><view><text class="title">{{copy.app}}</text><text class="sub">{{statusText}}</text></view><button class="gear" bindtap="setup">⚙</button></view>
    <view class="tabs" role="navigation"><button class="tab {{tab === 'scores' ? 'selected' : ''}}" data-tab="scores" bindtap="selectTab">{{copy.scores}}</button><button class="tab {{tab === 'schedule' ? 'selected' : ''}}" data-tab="schedule" bindtap="selectTab">{{copy.schedule}}</button><button class="tab {{tab === 'standings' ? 'selected' : ''}}" data-tab="standings" bindtap="selectTab">{{copy.standings}}</button><button class="tab {{tab === 'detail' ? 'selected' : ''}}" data-tab="detail" bindtap="selectTab">{{copy.detail}}</button></view>
    <view class="bar"><text class="week">{{copy.week}} {{snapshot.week || '—'}} · {{snapshot.season || '—'}}</text><text class="update">{{copy.updated}} {{lastUpdated || '—'}}</text><button class="refresh" bindtap="refresh">↻</button></view>
    <view ink:if="{{tab === 'scores' || tab === 'schedule'}}" class="list"><view ink:if="{{!snapshot || snapshot.games.length === 0}}" class="empty"><text>{{status === 'loading' ? copy.loading : copy.noGames}}</text></view><view ink:for="{{snapshot.games}}" ink:key="id" ink:if="{{tab === 'scores' || !item.live}}" class="game" data-index="{{index}}" bindtap="chooseGame"><view class="game-head"><text class="game-status {{item.live ? 'live' : ''}}">{{item.live ? copy.live : item.final ? copy.final : copy.upcoming}}</text><text class="game-meta">{{item.status || item.date}}</text></view><view class="teams"><view class="team"><text class="abbr">{{item.away.abbr}}</text><text class="name">{{item.away.name}}</text><text class="score">{{item.away.score}}</text></view><view class="team"><text class="abbr">{{item.home.abbr}}</text><text class="name">{{item.home.name}}</text><text class="score">{{item.home.score}}</text></view></view><text class="venue">{{item.venue}} {{item.city ? '· ' + item.city : ''}}</text></view></view>
    <view ink:if="{{tab === 'standings'}}" class="list standings"><view ink:for="{{standings}}" ink:key="name" class="conference"><text class="conference-name">{{item.name}}</text><view class="table-head"><text>{{copy.rank}}</text><text>{{copy.team}}</text><text>{{copy.records}}</text><text>{{copy.pct}}</text></view><view ink:for="{{item.entries}}" ink:key="abbr" class="standing"><text>{{item.rank}}</text><text class="standing-team">{{item.abbr}} <small>{{item.name}}</small></text><text>{{item.record}}</text><text>{{item.pct}}</text></view></view></view>
    <view ink:if="{{tab === 'detail'}}" class="list detail"><view ink:if="{{!snapshot || !snapshot.games[selected]}}" class="empty"><text>{{copy.noGames}}</text></view><view ink:else class="detail-card"><view class="detail-title"><text>{{snapshot.games[selected].shortName}}</text><text class="game-status live" ink:if="{{snapshot.games[selected].live}}">{{copy.live}}</text></view><view class="detail-teams"><text>{{snapshot.games[selected].away.name}}</text><text class="detail-score">{{snapshot.games[selected].away.score}}</text><text>{{snapshot.games[selected].home.name}}</text><text class="detail-score">{{snapshot.games[selected].home.score}}</text></view><text class="quarter-label">{{copy.quarter}}</text><view class="quarters"><view class="quarter"><text>{{copy.q1}}</text><text>{{snapshot.games[selected].away.linescores[0] || '—'}}</text><text>{{snapshot.games[selected].home.linescores[0] || '—'}}</text></view><view class="quarter"><text>{{copy.q2}}</text><text>{{snapshot.games[selected].away.linescores[1] || '—'}}</text><text>{{snapshot.games[selected].home.linescores[1] || '—'}}</text></view><view class="quarter"><text>{{copy.q3}}</text><text>{{snapshot.games[selected].away.linescores[2] || '—'}}</text><text>{{snapshot.games[selected].home.linescores[2] || '—'}}</text></view><view class="quarter"><text>{{copy.q4}}</text><text>{{snapshot.games[selected].away.linescores[3] || '—'}}</text><text>{{snapshot.games[selected].home.linescores[3] || '—'}}</text></view></view><text class="detail-meta">{{copy.venue}} · {{snapshot.games[selected].venue}} {{snapshot.games[selected].city ? '· ' + snapshot.games[selected].city : ''}}</text><text class="detail-meta">{{snapshot.games[selected].status}}</text></view></view>
    <view class="footer"><text class="note">{{status === 'error' ? copy.error : status === 'offline' ? copy.offline : copy.note}}</text><button class="footer-btn" bindtap="setup">{{copy.settings}}</button></view>
  </view>
</page>
<style>
.page { width:100%; height:100%; box-sizing:border-box; padding:12px 16px; display:flex; flex-direction:column; background-color:#000; color:#00ff66; }.heading { display:flex; flex-direction:row; justify-content:space-between; align-items:center; }.title { font-size:23px; line-height:26px; font-weight:700; letter-spacing:2px; }.sub { display:block; font-size:10px; line-height:15px; color:#00bc4b; }.gear { font-size:16px; padding:3px 8px; min-height:28px; }.tabs { display:flex; flex-direction:row; margin-top:8px; }.tab { flex:1; margin-right:5px; padding:3px 2px; font-size:12px; line-height:20px; min-height:29px; }.tab:last-child { margin-right:0; }.selected { border-color:#00ff66; background-color:#001f0d; font-weight:700; }.bar { display:flex; flex-direction:row; align-items:center; margin-top:6px; min-height:20px; }.week { font-family:monospace; font-size:11px; color:#00d856; }.update { margin-left:auto; font-size:10px; color:#00bc4b; }.refresh { margin-left:5px; padding:1px 7px; font-size:15px; min-height:25px; }.list { flex:1; min-height:0; overflow:hidden; display:flex; flex-direction:column; }.game { padding:6px 0 5px; border-bottom:1px solid #00451c; }.game-head { display:flex; flex-direction:row; align-items:center; }.game-status { font-size:10px; line-height:16px; color:#00bc4b; }.game-status.live { color:#00ff66; font-weight:700; }.game-meta { margin-left:auto; font-size:10px; color:#00bc4b; }.teams { display:flex; flex-direction:column; margin-top:2px; }.team { display:flex; flex-direction:row; align-items:center; min-height:24px; }.abbr { width:44px; font-size:15px; font-weight:700; }.name { flex:1; font-size:14px; color:#00d856; }.score { width:34px; text-align:right; font-size:20px; font-weight:700; }.venue { font-size:10px; line-height:15px; color:#008f38; }.empty { flex:1; display:flex; align-items:center; justify-content:center; color:#00bc4b; font-size:14px; }.conference { margin-bottom:10px; }.conference-name { display:block; font-size:16px; line-height:22px; color:#00ff66; border-bottom:1px solid #008536; }.table-head,.standing { display:grid; grid-template-columns:28px 1fr 58px 44px; column-gap:3px; align-items:center; min-height:22px; font-size:11px; }.table-head { color:#008f38; border-bottom:1px solid #00451c; }.standing { font-size:12px; border-bottom:1px solid #003514; }.standing-team { color:#00d856; }.standing-team small { color:#008f38; font-size:10px; }.detail-card { padding-top:5px; }.detail-title { display:flex; flex-direction:row; justify-content:space-between; font-size:18px; font-weight:700; }.detail-teams { display:grid; grid-template-columns:1fr 40px; row-gap:5px; margin-top:14px; font-size:15px; color:#00d856; }.detail-score { text-align:right; font-size:22px; color:#00ff66; font-weight:700; }.quarter-label { display:block; margin-top:15px; font-size:11px; color:#00bc4b; }.quarters { display:flex; flex-direction:row; margin-top:4px; border-top:1px solid #008536; border-bottom:1px solid #008536; }.quarter { flex:1; display:flex; flex-direction:column; align-items:center; padding:5px 0; border-right:1px solid #00451c; font-size:13px; line-height:21px; }.quarter:last-child { border-right:0; }.quarter text:first-child { font-size:10px; color:#00bc4b; }.detail-meta { display:block; margin-top:9px; font-size:11px; line-height:17px; color:#00bc4b; }.footer { display:flex; flex-direction:row; align-items:center; margin-top:5px; min-height:25px; }.note { flex:1; font-size:10px; color:#00bc4b; }.footer-btn { padding:2px 7px; font-size:11px; min-height:25px; }
@media (target:_current) { .page { padding:10px 16px; }.title { font-size:18px; }.sub,.update,.venue,.detail-meta { font-size:9px; }.tab { font-size:11px; }.game { padding:4px 0; }.name { font-size:13px; }.score { font-size:18px; }.standing-team small { display:none; }.conference { margin-bottom:5px; }.detail-teams { margin-top:8px; }.footer { margin-top:3px; } }
</style>
